<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Claude Code Dock"
                factoryClass="dev.reginaldomorais.claudedock.ClaudeToolWindowFactory"
                anchor="right"
                icon="/icons/claudeDuckMono.svg"
                canCloseContents="true"/>
    </extensions>

    <actions>
        <!-- Sem atalho padrão: o "natural" é do plugin oficial, e mexer no keymap viola RF-13. -->
        <action id="dev.reginaldomorais.claudedock.SendSelection"
                class="dev.reginaldomorais.claudedock.actions.SendSelectionAction"
                text="Enviar Seleção para o Claude Code"
                description="Envia o trecho selecionado para a sessão em foco da janela dedicada"
                icon="/icons/claudeDuckMono.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="dev.reginaldomorais.claudedock.OpenClaudeDock"
                class="dev.reginaldomorais.claudedock.actions.OpenClaudeDockAction"
                text="Abrir Claude Code Dock"
                description="Abre a tool window dedicada do Claude Code"
                icon="/icons/claudeDuckMono.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
